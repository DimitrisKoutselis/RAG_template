# Application Settings
APP_NAME=RAG Template
APP_VERSION=0.1.0
DEBUG=true

# RAG Engine Selection: "langchain" or "langgraph"
RAG_IMPLEMENTATION=langchain

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyB8iyMImnfkZqctzMGnnTIw5vBS0yBhUmM
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# Vector Store Configuration
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_chunks

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# RAG Defaults
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.7

# Chunking Configuration
CHUNKS_DIRECTORY=./chunks
